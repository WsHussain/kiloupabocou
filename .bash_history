import subprocess
import os

# Check if fonttools is installed, if not install it
try:
    import fontTools
except ImportError:
    print('Installing fonttools...')
    subprocess.run(['pip3', 'install', 'fonttools[woff]', 'brotli'], check=True)

# Convert OTF to WOFF2 and WOFF
from fontTools.ttLib import TTFont
from fontTools.subset import Subsetter

# Load the font
font = TTFont('Koutura-Regular.otf')

# Save as WOFF2 (best compression)
font.flavor = 'woff2'
font.save('koutura.woff2')
print('✅ Generated koutura.woff2')

# Save as WOFF (fallback)
font.flavor = 'woff'
font.save('koutura.woff')
print('✅ Generated koutura.woff')

print('✅ Font conversion completed!')
"
