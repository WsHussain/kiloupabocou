import base64
import subprocess
import os

# Vérifier si fonttools est disponible
try:
    from fontTools.ttLib import TTFont
    from fontTools.subset import Subsetter
    print('fontTools is available')
except ImportError:
    print('Installing fonttools...')
    subprocess.run(['pip3', 'install', 'fonttools', 'brotli'], check=True)
    from fontTools.ttLib import TTFont

# Convertir OTF vers WOFF2 et WOFF
def convert_font():
    input_file = './fonts/Koutura-Regular.otf'
    woff2_file = './fonts/Koutura-Regular.woff2'
    woff_file = './fonts/Koutura-Regular.woff'
    
    if os.path.exists(input_file):
        print(f'Converting {input_file}...')
        
        # Conversion vers WOFF2
        try:
            subprocess.run(['fonttools', 'ttLib.woff2', 'compress', input_file, woff2_file], check=True)
            print(f'✅ Created {woff2_file}')
        except subprocess.CalledProcessError:
            print('⚠️ fonttools woff2 compress failed, trying alternative method...')
            # Alternative: utiliser pyftsubset pour créer woff2
            subprocess.run(['pyftsubset', input_file, '--output-file=' + woff2_file, '--flavor=woff2'], check=True)
            print(f'✅ Created {woff2_file} (alternative method)')
        
        # Conversion vers WOFF
        try:
            subprocess.run(['fonttools', 'ttLib.woff2', 'compress', input_file, woff_file, '--flavor=woff'], check=True)
            print(f'✅ Created {woff_file}')
        except subprocess.CalledProcessError:
            subprocess.run(['pyftsubset', input_file, '--output-file=' + woff_file, '--flavor=woff'], check=True)
            print(f'✅ Created {woff_file} (alternative method)')
        
        print('Font conversion completed!')
    else:
        print(f'❌ Source file not found: {input_file}')

convert_font()
"
